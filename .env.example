# AI (Vercel AI Gateway). Without this the app still works using built-in offline matching and canned Ollie replies.
AI_GATEWAY_API_KEY=
# Optional: override the model (default anthropic/claude-haiku-5-5)
AI_MODEL=

# Supabase (optional): saves kids' answers and powers read-only share links. Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
